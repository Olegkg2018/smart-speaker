# Секреты и локальные настройки
.env

# Модели и музыка — большие, качаются отдельно
server/models/*
!server/models/.gitkeep
server/music/*
!server/music/.gitkeep
# Память разговоров, списки, лог и т.п. — на плате это отдельная папка на
# HDD (см. CLAUDE.md), сюда попадает только если что-то запустить локально.
server/data/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# ESP-IDF
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/managed_components/
firmware/dependencies.lock
# Настройки Wi-Fi и адрес сервера: у каждого свои, пароль в git не нужен.
firmware/sdkconfig.local
