# Скопируйте в sdkconfig.local и впишите свои значения.
#
# ESP-IDF подхватывает этот файл после sdkconfig.defaults, поэтому
# настройки переживают удаление sdkconfig — а его приходится удалять при
# смене разметки флеша или набора моделей. Настройки Wi-Fi, которые жили
# только в sdkconfig, при этом молча возвращались к заводским, и колонка
# уходила искать сеть «myssid».
#
# Файл в .gitignore: пароль от домашней сети в репозитории не нужен.

CONFIG_HAPPY_WIFI_SSID="имя вашей сети"
CONFIG_HAPPY_WIFI_PASSWORD="пароль, пусто для открытой сети"
CONFIG_HAPPY_SERVER_URI="ws://адрес-платы:8090/stream"
CONFIG_HAPPY_DEVICE_NAME="kitchen"
