# Скопируйте в .env и заполните.

ANTHROPIC_API_KEY=sk-ant-...

# Публичные Telegram-каналы для новостей: читаются через веб-превью
# (t.me/s/канал), без API и токенов. Идут вперемешку с лентами СМИ.
NEWS_TELEGRAM_CHANNELS=["insiderUKR", "hyevuy_k_r"]

# Город по умолчанию для погоды (координаты — чтобы не ходить в геокодер).
DEFAULT_CITY=Кривий Ріг
DEFAULT_LATITUDE=47.9105
DEFAULT_LONGITUDE=33.3918

# Модель распознавания. Замер на S905X3: `base` — около 4.7 с на фразу,
# `tiny` — 2.6 с ценой заметных ошибок. Меньше двух секунд Whisper на этом
# процессоре не даёт (см. tools/bench.py).
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4

# Голос синтеза (файл models/<имя>.onnx).
PIPER_VOICE=ru_RU-irina-medium

# Скорость мышления модели: low для голоса, выше — для сложных задач.
EFFORT=low

# Экран колонки. Шрифт нужен любой с кириллицей.
SCREEN_ENABLED=true
SCREEN_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# Кнопка и активационное слово только начинают запись — конец реплики
# находит детектор тишины. Порог адаптивный: считается от фонового шума
# комнаты, а VAD_THRESHOLD задаёт нижнюю границу. Поднимите её, если колонка
# реагирует на шум; опустите, если не слышит речь с расстояния.
VAD_THRESHOLD=150
VAD_SPEECH_FACTOR=3.0
VAD_SILENCE_MS=900
VAD_MIN_SPEECH_MS=200

# Активация голосом. Пока слово не прозвучало, звук не покидает дом и денег
# не стоит: его проверяет локальная модель Vosk. Кнопка продолжает работать.
# Модель: https://alphacephei.com/vosk/models (vosk-model-small-ru-0.22),
# распаковать в models/vosk-ru.
WAKE_WORD_ENABLED=false
WAKE_WORD=слушай компьютер
# Замерено: короткие слова притягивают созвучия («Алиса» ловится на «Ларису»
# и «Мелиссу»), длинные — нет. Для короткого слова перечислите похожие через
# запятую в WAKE_WORD_NEIGHBOURS — распознавателю будет куда их деть.
WAKE_WORD_NEIGHBOURS=[]
WAKE_LISTEN_TIMEOUT_S=8
# Пока играет музыка, микрофон слышит её же, а эхоподавления на плате нет:
# распознаватель ловит слова из песни и колонка выполняет команды, которых
# никто не давал. Поэтому во время музыки активация только кнопкой.
WAKE_WORD_WHILE_PLAYING=false

# Голосовой бэкенд: claude (по умолчанию, локальный STT/TTS) или
# openai_realtime (платный спич-ту-спич, без паузы на распознавание).
VOICE_PROVIDER=claude
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=marin
# Realtime переотправляет весь контекст на каждый ответ, поэтому длинный
# разговор дорожает с каждой репликой. Потолок контекста в токенах и доля,
# которая остаётся после обрезки.
REALTIME_CONTEXT_TOKENS=4000
REALTIME_RETENTION_RATIO=0.6

# Распознавание и синтез можно по отдельности вынести в облако, оставив
# мозги на Claude: local — faster-whisper / Piper, openai — whisper-1 / tts-1.
# На S905X3 облако заметно быстрее локального Whisper (~5 с на фразу) и
# звучит живее Piper. Требует OPENAI_API_KEY.
STT_PROVIDER=local
TTS_PROVIDER=local
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
# Голоса tts-1: alloy, echo, fable, onyx, nova, shimmer.
OPENAI_TTS_VOICE=nova

HOST=0.0.0.0
PORT=8080

# --- только для docker compose ---
# Порт на хосте (внутри контейнера всегда PORT). 8080 на сервере занят.
HAPPY_PORT=8090
# Локальная фонотека, подключается только на чтение.
HAPPY_MUSIC_DIR=./music
# Где лежит память разговоров — обычная папка на диске, а не том docker:
# её видно снаружи и она переживает даже `compose down -v`.
HAPPY_DATA_DIR=./data
